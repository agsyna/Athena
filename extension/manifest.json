{
  "manifest_version": 3,
  "name": "Athena — viva buddy",
  "version": "0.1.0",
  "description": "Highlight any passage and have a live, adaptive spoken viva about it.",
  "permissions": ["sidePanel", "scripting", "storage", "activeTab", "contextMenus"],
  "host_permissions": ["http://localhost:3000/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Start an Athena viva on the selected text",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
